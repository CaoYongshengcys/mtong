<view class="page-container">
  <view class="profile-header">
    <view class="profile-info" bindtap="onEditProfile">
      <image class="profile-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="profile-detail">
        <text class="profile-name">{{userInfo.nickName}}</text>
        <text class="profile-role">{{roleLabel}}</text>
      </view>
    </view>
    <text class="profile-edit">编辑 ></text>
  </view>

  <view class="offline-tip" wx:if="{{offlineCount > 0}}" bindtap="onSyncOffline">
    <text class="offline-tip-text">有{{offlineCount}}条离线数据待同步，点击同步</text>
  </view>

  <view class="section">
    <view class="menu-list">
      <view class="menu-item" wx:for="{{menuList}}" wx:key="title" bindtap="onMenuTap" data-url="{{item.url}}">
        <text class="menu-icon">{{item.icon}}</text>
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="menu-list">
      <view class="menu-item" bindtap="onAbout">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-title">关于系统</text>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <view class="section">
    <button class="logout-btn" bindtap="onLogout">退出登录</button>
  </view>
</view>
