.plot-list {
  padding: 20rpx 30rpx;
}

.plot-card {
  margin-bottom: 20rpx;
}

.plot-header {
  margin-bottom: 20rpx;
}

.plot-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.plot-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.plot-info-item {
  width: 45%;
  display: flex;
  flex-direction: column;
}

.plot-info-value {
  font-size: 28rpx;
  color: #333333;
  margin-top: 4rpx;
}

.plot-footer {
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #2B7A4F;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(43, 122, 79, 0.4);
  z-index: 100;
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: 300;
}
