.form-row {
  display: flex;
  gap: 20rpx;
}

.form-group-half {
  flex: 1;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-arrow {
  color: #cccccc;
  font-size: 28rpx;
}

.placeholder {
  color: #999999;
}

.required::before {
  content: '*';
  color: #F44336;
  margin-right: 6rpx;
}

.gps-info {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.scan-btn {
  background-color: #2B7A4F;
  color: #ffffff;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.scan-btn-text {
  font-size: 24rpx;
  color: #ffffff;
}

.pesticide-warning {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  background-color: #FFEBEE;
  border-radius: 8rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-bottom-left-radius: 12rpx;
}

.photo-watermark {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 4rpx 8rpx;
}

.watermark-text {
  font-size: 18rpx;
  color: #ffffff;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #cccccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #cccccc;
  line-height: 1;
}

.photo-add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

.submit-bar {
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  width: 100%;
}

.flex-1 {
  flex: 1;
}
