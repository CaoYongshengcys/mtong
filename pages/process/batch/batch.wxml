<view class="page-container">
  <view class="sub-nav">
    <view class="sub-nav-item active">
      <text class="sub-nav-icon">📦</text>
      <text class="sub-nav-text">批次管理</text>
    </view>
    <view class="sub-nav-item" bindtap="navigateTo" data-url="/pages/process/iot-monitor/iot-monitor">
      <text class="sub-nav-icon">🌡️</text>
      <text class="sub-nav-text">IoT监控</text>
    </view>
    <view class="sub-nav-item" bindtap="navigateTo" data-url="/pages/process/e-record/e-record">
      <text class="sub-nav-icon">📋</text>
      <text class="sub-nav-text">电子记录</text>
    </view>
  </view>

  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="onFilterTap" data-status="all">全部</view>
      <view class="filter-item {{currentFilter === item.value ? 'active' : ''}}" wx:for="{{batchStatus}}" wx:key="value" bindtap="onFilterTap" data-status="{{item.value}}">
        {{item.label}}
      </view>
    </scroll-view>
  </view>

  <view class="batch-list">
    <view class="batch-card card" wx:for="{{batchList}}" wx:key="id" bindtap="onBatchTap" data-id="{{item.id}}">
      <view class="batch-header flex-between">
        <text class="batch-no">{{item.batchNo}}</text>
        <text class="tag {{item.statusTagClass}}">{{item.statusLabel}}</text>
      </view>
      <view class="batch-body">
        <view class="batch-info-row">
          <text class="text-muted">产品</text>
          <text class="batch-product">{{item.product}}</text>
        </view>
        <view class="batch-info-row">
          <text class="text-muted">数量</text>
          <text>{{item.quantity}} {{item.unit}}</text>
        </view>
        <view class="batch-info-row" wx:if="{{item.currentStation}}">
          <text class="text-muted">当前工位</text>
          <text class="text-primary">{{item.currentStation}}</text>
        </view>
      </view>
      <view class="batch-footer flex-between">
        <text class="text-sm text-muted">{{item.createTime}}</text>
        <text class="text-primary text-sm">查看详情 ></text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:if="{{batchList.length === 0 && !loading}}">
    <text class="empty-icon">📦</text>
    <text class="empty-text">暂无批次数据</text>
  </view>

  <view class="fab-group">
    <view class="fab fab-scan" bindtap="onScanCode">
      <text class="fab-icon-sm">📷</text>
    </view>
    <view class="fab" bindtap="onCreateBatch">
      <text class="fab-icon">+</text>
    </view>
  </view>
</view>
